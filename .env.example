PAIRING_API_KEY=put-a-long-random-secret-here
BOT_NAME=RIO X MD
PREFIX=.
MAX_SESSIONS=20
# Menu / alive image
MENU_IMAGE=https://files.catbox.moe/jy9p51.jpg
# Your number with country code, digits only (for the Owner button)
OWNER_NUMBER=
# Set BUTTONS=off to send image + text menu only
BUTTONS=on
TIMEZONE=Asia/Colombo
# Downloader
MAX_DL_MB=90
# YTDLP_PATH=/path/to/yt-dlp
# Session storage (recommended on Render free). MongoDB Atlas connection string:
MONGO_URL=
MONGO_DB=rio_x_md
# public = everyone can use commands, private = only the owner
MODE=public
# Link opened by the bot DP card on replies (optional, default: wa.me/owner)
# CARD_URL=https://your-site.example
